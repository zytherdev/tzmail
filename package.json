{
  "name": "@zyther/tzmail",
  "version": "0.4.0",
  "description": "TypeScript email templates, multi-provider delivery and optional BullMQ asynchronous queues.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "author": "zytherdev <zyther.dev@outlook.com>",
  "homepage": "https://github.com/zytherdev/tzmail#readme",
  "bugs": {
    "url": "https://github.com/zytherdev/tzmail/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zytherdev/tzmail.git"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC",
  "keywords": [
    "email",
    "nextjs",
    "typescript",
    "nodejs",
    "smtp",
    "sendgrid",
    "amazon-ses",
    "mailgun",
    "bullmq",
    "redis-queue",
    "mail",
    "nodemailer",
    "templates",
    "themes"
  ],
  "peerDependencies": {
    "nodemailer": "^6.9.0 || ^7 || ^8",
    "@aws-sdk/client-sesv2": "^3.0.0",
    "bullmq": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-sesv2": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/nodemailer": "^7.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "nodemailer": "^8.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.1"
  }
}
